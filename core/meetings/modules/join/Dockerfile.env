# meet-join runtime shape — the SOURCE OF TRUTH for the join layer's environment.
# Any service that assembles this brick builds FROM this image, instead of
# re-declaring the deps (MANIFEST P2/P6: runtime-shape is part of the contract;
# a service's env is the union of its bricks' shapes, depended-on not duplicated).
#
# Declares ONLY what the join code requires:
#   - Playwright + Chromium ONLY (the browser the brick drives)
#   - humanized X11 input: xvfb + xdotool + xclip  (without these the brick
#     silently degrades to synthetic input and gets bot-blocked)
#   - the live lens: x11vnc + novnc + websockify
#
# NOT built FROM mcr.microsoft.com/playwright:v1.56.0-noble (the obvious choice, and the one
# this image used until this change): that image bundles chromium + firefox + webkit + a separate
# chromium_headless_shell together, unconditionally — ~816MB of browsers this brick never drives
# (confirmed live: `du -sh /ms-playwright/*/` inside the old image showed chromium-1194 at 582M
# actually used; chromium_headless_shell-1194 316M, webkit-2215 255M, firefox-1495 245M all
# unused — the brick always runs a real, visible Chromium under Xvfb for humanized input, never
# headless, and only Chromium per the comment above). A later `rm -rf` of those dirs would NOT
# have reclaimed the space — OCI layers don't shrink that way; deleting a file in a later layer
# just hides it from the final filesystem view, the bytes from the layer that added it still ship.
# The only way to actually not pay for them is to never let the install add them: build the same
# Ubuntu noble + Node 22 environment ourselves and pass `chromium` explicitly to `playwright
# install --with-deps`, matching playwright@1.56.0 (join/remote-browser package.json) exactly so
# the installed browser revision matches what the code was built against.
#
# Trade-off, explicit: the upstream image is Microsoft's own maintained, validated pairing of
# Chromium + its OS-level deps for each Playwright release; this repo now owns tracking that
# pairing by hand across future `playwright` version bumps in join/remote-browser's package.json
# (bump the version here to match). Re-derived from `docker history` against the image this
# replaced — same Node 22 (nodesource), same base OS (ubuntu:24.04 = "noble") — only the browser
# install is narrowed.
#
# Build:  docker build -f Dockerfile.env -t vexa/meet-join-env:dev .
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# Node 22 via nodesource (same source the upstream MS image itself used — verified against its
# own `docker history`), then playwright-core pinned to the exact version join/remote-browser
# build against, with ONLY chromium installed (--with-deps pulls its OS-level deps too, scoped to
# just that browser instead of all three).
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates gpg git openssh-client \
    && mkdir -p /etc/apt/keyrings \
    && curl -sL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# --no-shell: chromium ships a SEPARATE headless-shell binary alongside the full browser by
# default (~316MB on its own) — dead weight here too, confirmed live (`du -sh /ms-playwright/*/`):
# the brick always launches a real, visible Chromium under Xvfb (the whole point of the
# humanized-X11 stack above), never Playwright's own headless mode.
RUN npm install -g playwright-core@1.56.0 \
    && playwright-core install --with-deps --no-shell chromium \
    && rm -rf /root/.npm \
    && chmod -R 777 /ms-playwright

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc websockify novnc xdotool xclip \
    && rm -rf /var/lib/apt/lists/*
